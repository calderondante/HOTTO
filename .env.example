# Public project coordinates; administration stays disabled until configured. Keep values empty here.
# Set local values in .env.local or in secure environment settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never add a service-role key or a database password to NEXT_PUBLIC_*.

# Empty selects Supabase when any project coordinate is present; partial config reports an error.
HOTTO_DATA_SOURCE=

# Exact public origin for HTTPS deployments behind a reverse proxy; no secrets.
HOTTO_SITE_ORIGIN=

# Server-only email allowlist for Magic Link requests (comma-separated).
# Does NOT grant admin rights; active private.library_admins membership is also required.
HOTTO_ADMIN_EMAILS=
